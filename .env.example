# =============================================================================
# Dashboard Environment Variables
# Copy this to .env.local (development) or .env.production (production VPS)
#
# BUILD-TIME (baked into the Docker image — must be set as GitHub Actions
#   Variables/Secrets or docker build-args before `next build`).
#   NOTE: config/* is imported by client components (RTK Query runs in the
#   browser), so API_URL / SCRAPER_API_URL / API_KEY ship in the client
#   bundle. Treat API_KEY accordingly.
#   API_URL, SCRAPER_API_URL, API_KEY, NEXT_PUBLIC_FRONTEND_URL
# RUNTIME (read by the server on every boot — provide via env_file;
#   same image works in any environment):
#   NEXTAUTH_URL, NEXTAUTH_SECRET
# =============================================================================

# Backend API URL (server + client)
API_URL=http://localhost:5000/api

# Scraper API URL (server + client)
SCRAPER_API_URL=http://localhost:3000/api

# Direct service addresses for server-side fetches (server-only).
# In Docker Compose these are set to http://backend:5000/api and
# http://scraper:5010/api (same network, no TLS hairpin). Leave unset
# for local dev to fall back to the public URLs above.
# API_URL_INTERNAL=http://backend:5000/api
# SCRAPER_API_URL_INTERNAL=http://scraper:5010/api

# Server-to-server key, sent as x-api-key header (also reaches client bundle!)
API_KEY=

# Public storefront URL, used for "view on site" links (client)
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3001

# NextAuth (server-only)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_me_to_a_random_secret
